@*このViewがProductモデルを受け取る*@
@model List<MvcBasicSample.Models.Product>
@{
    ViewData["Title"] = "商品一覧";    //タブ用のタイトル
    var products = new[]
    {
        new { name = "ノート", Price = 250 },
        new { name = "ペン", Price = 150 },
        new { name = "消しゴム", Price = 100 }
    };

    int total = 0;
    foreach (var product in products)
    {
        total += product.Price;
    }
}

<h1>商品一覧</h1>  @*画面内の見出し*@
<ul>
    @foreach (var product in products)
    {
        <li>@product.name:@product.Price 円</li>
    }
</ul>
<p>合計金額: @total 円</p>