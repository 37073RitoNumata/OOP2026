@*このViewがProductモデルを受け取る*@
@model List<MvcBasicSample.Models.Product>
@{
    ViewData["Title"] = "商品情報";    //タブ用のタイトル
    string productName1 = "ノート";
    int price1 = 250;
    string productName2 = "ペン";
    int price2 = 150;
    int total = price1 + price2;
}

<h1>商品情報</h1>  @*画面内の見出し*@
<p>商品名:@productName1:@price1 円</p>
<p>商品名:@productName2:@price2 円</p>
<p>合計金額:@total 円</p>
